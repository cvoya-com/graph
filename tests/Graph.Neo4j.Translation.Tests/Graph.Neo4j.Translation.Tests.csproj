<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(GraphRuntimeTargetFrameworks)</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>Cvoya.Graph.Neo4j.Translation.Tests</RootNamespace>
        <AssemblyName>Cvoya.Graph.Neo4j.Translation.Tests</AssemblyName>

        <!-- Use the new testing platform -->
        <UseMicrosoftTestingPlatform>true</UseMicrosoftTestingPlatform>

        <!--
          xunit.v3's own generated entry point already dispatches to Microsoft.Testing.Platform
          when invoked in server mode, so the separately-generated Microsoft.Testing.Platform.MSBuild
          entry point is redundant and triggers CS8892 (unused entry point because a synchronous
          entry point was found).
        -->
        <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>

        <!-- Enable live output -->
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
        <TestingPlatformShowProgress>true</TestingPlatformShowProgress>
        <TestingPlatformCaptureOutput>true</TestingPlatformCaptureOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-v2" />
        <PackageReference Include="Verify.XunitV3" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="VerifyXunit" />
    </ItemGroup>

    <!--
        Verify's own MSBuild target (WriteVerifyAttributes, from its buildTransitive props/targets)
        does not fire reliably in this project — likely due to interaction with the
        Microsoft.Testing.Platform / xunit.v3.mtp-v2 build pipeline reshaping the standard SDK
        import order. Emit the `Verify.ProjectDirectory` assembly-metadata attribute Verify needs
        for project-relative snapshot directories directly, so tests don't depend on that target.
    -->
    <ItemGroup>
        <AssemblyMetadata Include="Verify.ProjectDirectory" Value="$(MSBuildProjectDirectory)\" />
        <AssemblyMetadata Include="Verify.ProjectName" Value="$(MSBuildProjectName)" />
        <AssemblyMetadata Include="Verify.TargetFrameworks" Value="$(TargetFramework)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Graph.Neo4j\Graph.Neo4j.csproj" />
        <ProjectReference Include="..\..\src\Graph.Analyzers\Graph.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\src\Graph.Serialization.CodeGen\Graph.Serialization.CodeGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(UseProjectReferences)' == 'true'" />
    </ItemGroup>

</Project>
